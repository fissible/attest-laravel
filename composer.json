{
    "name": "fissible/attest-laravel",
    "description": "Laravel adapter for fissible/attest: Eloquent storage, console commands, scheduled anchoring, events.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "audit", "tamper-evident", "fissible"],
    "authors": [
        {"name": "Allen McCabe", "email": "allenmccabe@gmail.com"}
    ],
    "require": {
        "php": "^8.2",
        "fissible/attest": "^1.0",
        "illuminate/bus": "^11.0 || ^12.0",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/queue": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.7",
        "guzzlehttp/psr7": "^2.6",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Fissible\\AttestLaravel\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Fissible\\AttestLaravel\\Tests\\": "tests/"}
    },
    "repositories": [
        {
            "type": "path",
            "url": "../attest",
            "options": {
                "symlink": false,
                "versions": {
                    "fissible/attest": "1.0.0"
                }
            }
        }
    ],
    "extra": {
        "laravel": {
            "providers": ["Fissible\\AttestLaravel\\AttestServiceProvider"],
            "aliases": {"Attest": "Fissible\\AttestLaravel\\Facades\\Attest"}
        }
    },
    "config": {
        "sort-packages": true
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 HTTP client used by OpenTimestamps calendars and Bitcoin header provider commands.",
        "guzzlehttp/psr7": "PSR-7 factories used by OpenTimestamps calendars and Bitcoin header provider commands."
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
